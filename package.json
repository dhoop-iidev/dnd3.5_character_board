{
  "name": "dnd35-playboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "check": "node node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.app.json && node node_modules/typescript/bin/tsc -p tsconfig.node.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "data": "python tools/build_data.py"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "three": "^0.186.1"
  }
